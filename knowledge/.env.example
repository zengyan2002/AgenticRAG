# 复制为 .env 后填写密钥；.env 已被 Git 忽略，不要提交真实值。
DASHSCOPE_API_KEY=
MINERU_API_TOKEN=

# DashScope OpenAI-compatible API
DASHSCOPE_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_DEFAULT_MODEL=qwen-plus
# 按职责拆分文本模型；未配置时回退 LLM_DEFAULT_MODEL。
LLM_FAST_MODEL=qwen-flash
LLM_AGENT_MODEL=qwen3.8-flash
LLM_ANSWER_MODEL=qwen3.8-flash
# 非 Qwen3.8 模型使用的 light/deep 思考预算；Qwen3.8 映射为 low/medium。
LLM_LIGHT_THINKING_BUDGET=4096
LLM_DEEP_THINKING_BUDGET=16384
VL_MODEL=qwen-vl-plus

# MinerU
MINERU_BASE_URL=https://mineru.net/api/v4

# Local BGE models
BGE_M3_PATH=/models/bge-m3
BGE_DEVICE=cpu
BGE_FP16=false
BGE_RERANKER_LARGE=/models/bge-reranker-v2-m3
BGE_RERANKER_DEVICE=cpu
BGE_RERANKER_FP16=false

# Milvus
MILVUS_URL=http://127.0.0.1:19530
CHUNKS_COLLECTION=kb_chunks_v1
BM25_COLLECTION=kb_chunks_v2
DOCUMENT_REGISTRY_COLLECTION=kb_document_registry_v1
BM25_ENABLED=true
BM25_ANALYZER_TYPE=chinese
EMBEDDING_DIM=1024

# MinIO
MINIO_ENDPOINT=127.0.0.1:9000
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET_NAME=knowledge-rag
MINIO_SECURE=false

# MongoDB
MONGO_URL=mongodb://127.0.0.1:27017
MONGO_DB_NAME=knowledge_rag

# API（两个服务都必须保持单 Worker）
CORS_ORIGINS=*

# Import
DOCUMENT_TITLE_REVIEW_THRESHOLD=0.65
FORMULA_SEMANTIC_ENABLED=true
FORMULA_SEMANTIC_MAX_FORMULAS=10
FORMULA_SEMANTIC_BATCH_SIZE=20
FORMULA_SEMANTIC_MAX_WORKERS=3
FORMULA_SEMANTIC_CONTEXT_CHARS_PER_FORMULA=600
LIBREOFFICE_PATH=
WORD_CONVERT_TIMEOUT_SECONDS=120
IMPORT_DEBUG_ARTIFACTS=false
KEEP_IMPORT_ARTIFACTS=false
KEEP_FAILED_ARTIFACTS=true

# Retrieval and reranking
MAX_CONTEXT_CHARS=12000
MAX_QUERY_IMAGE_BYTES=10485760
EMBEDDING_SEARCH_LIMIT=12
HYDE_SEARCH_LIMIT=12
BM25_SEARCH_LIMIT=12
HYBRID_DENSE_WEIGHT=0.5
HYBRID_SPARSE_WEIGHT=0.5
HYDE_USE_SPARSE=false
SOFT_ROUTE_WEIGHT=0.35
DOCUMENT_ROUTE_LIMIT=10
DOCUMENT_ROUTE_MAX_OPTIONS=3
DOCUMENT_REGISTRY_SCAN_LIMIT=1000
RRF_K=60
RRF_MAX_RESULTS=16
RRF_DIRECT_WEIGHT=0.50
RRF_HYDE_WEIGHT=0.30
RRF_BM25_WEIGHT=0.20
RRF_MIN_EXCLUSIVE_PER_BRANCH=0
RERANK_MAX_TOP_K=5
RERANK_MIN_TOP_K=3
RERANK_GAP_ABS=0.08
RERANK_FULL_QUERY_WEIGHT=0.40
RERANK_RETRIEVAL_QUERY_WEIGHT=0.60
RERANK_COVERAGE_ENABLED=true
RERANK_COVERAGE_CANDIDATE_TOP_K=6
RERANK_COVERAGE_QUERY_RANK_LIMIT=8
RERANK_COVERAGE_MIN_SCORE=0.10
CONFLICT_JUDGE_ENABLED=true
CONFLICT_JUDGE_RRF_RANK_LIMIT=5
CONFLICT_JUDGE_MAX_PAIRS=2
CONFLICT_JUDGE_MIN_CONFIDENCE=0.80
CONFLICT_JUDGE_DOCUMENT_MAX_CHARS=1800
CONTEXT_EXPANSION_TOP_K=3
CONTEXT_EXPANSION_WINDOW=1
CONTEXT_EXPANSION_MAX_CHARS=4000

# Selective Agentic RAG（默认关闭，完成定向评测后再启用）
AGENTIC_RAG_ENABLED=false
AGENTIC_RAG_MODE=hybrid
AGENT_MAX_ITERATIONS=2
AGENT_MAX_SUBQUESTIONS=4
AGENT_MAX_TOOL_CALLS=6
AGENT_HYDE_ENABLED=false
AGENT_HYDE_MAX_QUERIES=1
AGENT_TIMEOUT_SECONDS=60
AGENT_MIN_EVIDENCE_CONFIDENCE=0.75
AGENT_EVIDENCE_MAX_CHARS=8000
AGENT_EVIDENCE_POOL_MAX=8
EVIDENCE_EVAL_MAX_CHARS_PER_DOC=1500
ANSWER_MAX_CHARS_PER_EVIDENCE=2500
